+fn sway_backend() -> bool {
+    std::env::var("NT_INPUT_BACKEND").as_deref() == Ok("sway")
+}
+
+fn sway_clients(tree: &Value, clients: &mut Vec<Value>) {
+    if tree["app_id"].is_string() {
+        clients.push(tree.clone());
+    }
+    for child in ["nodes", "floating_nodes"]
+        .into_iter()
+        .filter_map(|key| tree[key].as_array())
+        .flatten()
+    {
+        sway_clients(child, clients);
+    }
+}
+
 fn clients() -> io::Result<Vec<Value>> {
-    Ok(serde_json::from_value(hypr_json(&["clients"])?)?)
+    if !sway_backend() {
+        return Ok(serde_json::from_value(hypr_json(&["clients"])?)?);
+    }
+    let output = Command::new("swaymsg").args(["-t", "get_tree"]).output()?;
+    if !output.status.success() {
+        return Err(io::Error::other("swaymsg get_tree failed"));
+    }
+    let mut clients = Vec::new();
+    sway_clients(&serde_json::from_slice(&output.stdout)?, &mut clients);
+    Ok(clients)
 }
 
